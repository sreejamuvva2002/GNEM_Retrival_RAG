# ============================================================================
# Fine-Tuning Configuration
# ============================================================================
# Copy this section to your .env file and configure based on your setup

# ---- LLM Provider for Data Generation ----
# Options: "ollama" (local), "vllm" (local), "openai" (API), "gemini" (API)
DATA_GEN_LLM_PROVIDER=ollama

# ---- Ollama Configuration (Local, Free) ----
OLLAMA_BASE_URL=http://localhost:11434
DATA_GEN_OLLAMA_MODEL=qwen2.5:14b
# Alternative models: mistral, llama2, neural-chat, starling-lm, etc.

# ---- vLLM Configuration (Local, requires GPU) ----
# VLLM_BASE_URL=http://localhost:8000
# DATA_GEN_VLLM_MODEL=meta-llama/Llama-2-70b-hf

# ---- OpenAI Configuration (API, requires key) ----
# OPENAI_API_KEY=sk-...
# DATA_GEN_OPENAI_MODEL=gpt-4o

# ---- Google Gemini Configuration (API, requires key) ----
# GOOGLE_API_KEY=...
# DATA_GEN_GEMINI_MODEL=gemini-1.5-pro

# ---- Generation Parameters ----
DATA_GEN_TEMPERATURE=0.7                # Higher = more diverse, lower = more consistent
DATA_GEN_MAX_TOKENS=2048                # Max tokens per response
DATA_GEN_TIMEOUT=300                    # Timeout in seconds

# ============================================================================
# Data Augmentation Configuration
# ============================================================================

PARAPHRASE_COUNT=8                      # Number of paraphrases per question
KB_QUESTIONS_PER_CHUNK=3                # Questions per KB chunk
INCLUDE_ADVERSARIAL=true                # Generate "I don't know" questions

# ============================================================================
# Validation Configuration
# ============================================================================

VALIDATION_MIN_SCORE=4                  # Min score (1-5) to accept a pair
ENABLE_DEDUPLICATION=true               # Semantic deduplication
DEDUP_SIMILARITY_THRESHOLD=0.85         # Cosine similarity threshold

# ============================================================================
# Fine-Tuning Configuration (for Phase 4)
# ============================================================================

# LoRA Parameters
LORA_RANK=32                            # LoRA rank (16, 32, 64)
LORA_ALPHA=64                           # LoRA alpha (usually 2x rank)
LORA_DROPOUT=0.05                       # Dropout in LoRA layers

# Training Parameters
TRAINING_EPOCHS=2                       # Number of training epochs (1-3 recommended)
LEARNING_RATE=2e-4                      # Learning rate (2e-5 for full finetune, 2e-4 for LoRA)
BATCH_SIZE=4                            # Batch size (depends on GPU VRAM)
GRADIENT_ACCUMULATION_STEPS=4           # Accumulation steps (increases effective batch)
WARMUP_STEPS=100                        # Warmup steps
MAX_SEQ_LENGTH=2048                     # Max sequence length
SAVE_STEPS=500                          # Save checkpoint every N steps

# Model Configuration
BASE_MODEL=Qwen/Qwen2.5-14B            # Base model to fine-tune
QUANTIZATION=4bit                       # "4bit" or "8bit" for QLoRA

# ============================================================================
# Quick Test Configuration
# ============================================================================
# For testing with smaller dataset:
# PARAPHRASE_COUNT=2
# KB_QUESTIONS_PER_CHUNK=1
# TRAINING_EPOCHS=1
