# Local LLM served through an OpenAI-compatible endpoint.
# Ollama default shown; LM Studio uses http://localhost:1234/v1,
# llama.cpp server / vLLM use whatever port you started them on.
LLM_BASE_URL=http://localhost:11434/v1

# Recommended: qwen3:14b (best quality/VRAM balance for this task).
# Lighter: qwen3:8b or llama3.1:8b. Heavier: qwen3:32b.
LLM_MODEL=qwen3:14b

# Only needed for servers that enforce a key (Ollama ignores it).
LLM_API_KEY=ollama
