NEON_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_LLM_MODEL="qwen2.5:14b"
OLLAMA_TEMPERATURE="0.1"
OLLAMA_TOP_P="0.9"
OLLAMA_NUM_PREDICT="4096"

EMBEDDING_MODEL="nomic-ai/nomic-embed-text-v1.5"
EMBEDDING_LOCAL_FILES_ONLY="false"
EMBEDDING_TRUST_REMOTE_CODE="true"
EMBEDDING_DOCUMENT_PREFIX="search_document:"
EMBEDDING_QUERY_PREFIX="search_query:"

PGVECTOR_BATCH_SIZE="64"

HYBRID_RETRIEVER_TOP_K="250"
HYBRID_RERANKER_TOP_K="45"
HYBRID_RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L12-v2"

# ---------------------------------------------------------------------------
# kb_builder — web crawler settings (all optional, defaults shown)
# ---------------------------------------------------------------------------
CRAWLER_CONCURRENCY="5"
CRAWLER_DEPTH="3"
CRAWLER_DELAY_SECONDS="1.0"
CRAWLER_USER_AGENT="GNEM-RAG-Bot/1.0 (research crawler)"
# Cron for periodic re-crawl (default: every Sunday at 02:00)
CRAWLER_SCHEDULE_CRON="0 2 * * 0"

# ---------------------------------------------------------------------------
# Backblaze B2 storage (leave blank to disable B2 upload)
# ---------------------------------------------------------------------------
# Create an Application Key in the B2 console with read+write on your bucket.
# Endpoint format: https://s3.<region>.backblazeb2.com
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME="gnem-raw-docs"
B2_ENDPOINT_URL="https://s3.us-west-004.backblazeb2.com"
