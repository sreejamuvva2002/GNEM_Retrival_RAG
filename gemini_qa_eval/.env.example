# ---------------------------------------------------------------------------
# Gemini API
# ---------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Answer-generation model (used by all three modes)
GEMINI_MODEL="gemini-2.5-flash"
# Judge model — deliberately a *different / stronger* model than the answerer
# so the judge is not grading its own output style.
GEMINI_JUDGE_MODEL="gemini-2.5-pro"
# Embedding model (answer-relevancy + hybrid retrieval)
GEMINI_EMBED_MODEL="gemini-embedding-001"

# Decoding
GEMINI_TEMPERATURE="0.0"
GEMINI_MAX_OUTPUT_TOKENS="2048"
GEMINI_SEED="7"

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
QUESTIONS_PATH="data/questions.xlsx"
COMPANY_DATA_PATH="data/company_data.xlsx"
N_QUESTIONS="30"

# ---------------------------------------------------------------------------
# Retrieval (mode 2 and 3)
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K="25"
# "bm25" (no API calls) or "hybrid" (BM25 + Gemini embeddings, fused with RRF)
RETRIEVAL_STRATEGY="hybrid"

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# 1 = never call the API, return deterministic stub answers (offline dev/CI)
GQE_MOCK="0"
GQE_CACHE_DIR=".cache"
GQE_MAX_RETRIES="5"

# Optional: current Gemini list price, USD per 1M tokens, for the cost column.
# Leave at 0 to omit cost from reports rather than report a stale number.
PRICE_INPUT_PER_1M="0"
PRICE_OUTPUT_PER_1M="0"
